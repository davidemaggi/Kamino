{
  "name": "@kamino/plugin",
  "version": "1.0.0-rc.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx esbuild.config.mjs",
    "build:dev": "tsx esbuild.config.mjs --dev",
    "build:vault": "tsx esbuild.config.mjs --dev && tsx scripts/install-vault.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "release:versions": "tsx scripts/release.ts versions"
  },
  "dependencies": {
    "@kamino/brand": "workspace:*",
    "@kamino/protocol": "workspace:*",
    "@kamino/status": "workspace:*",
    "@kamino/sync-engine": "workspace:*",
    "@kamino/ui-diff": "workspace:*",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@kamino/tsconfig": "workspace:*",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.0",
    "obsidian": "^1.14.4",
    "vitest": "^5.1.0"
  }
}
