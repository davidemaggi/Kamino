{
  "name": "kamino-spikes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Throwaway M0 spikes R-1..R-5. Standalone project, NOT part of the pnpm workspace. Install with `pnpm install --ignore-workspace`.",
  "scripts": {
    "build": "node obsidian-spike-plugin/esbuild.config.mjs",
    "typecheck": "tsc --noEmit -p obsidian-spike-plugin/tsconfig.json && tsc --noEmit -p test-server/tsconfig.json",
    "test": "tsx --test test-server/src/*.test.ts",
    "server": "tsx test-server/src/server.ts",
    "smoke": "tsx test-server/src/smoke.ts"
  },
  "dependencies": {
    "@codemirror/merge": "6.12.3",
    "@noble/hashes": "2.4.0",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@codemirror/state": "6.7.6",
      "@codemirror/view": "6.43.13"
    }
  }
}
