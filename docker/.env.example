# Copy to docker/.env and edit. docker/.env is gitignored.

# Password of the bundled Postgres. Use only URL-safe characters (letters, digits, - _ . ~):
# it is embedded in the database URL.
KAMINO_DB_PASSWORD=change-me

# Public URL clients use to reach the server (no trailing slash).
KAMINO_PUBLIC_URL=http://localhost:8080

# Optional
# KAMINO_LOG_LEVEL=info
# KAMINO_BUILD_COMMIT=unknown

# compose.caddy.yml only: public domain (DNS must point to this host; ports 80/443 open).
# KAMINO_DOMAIN=kamino.example.com
