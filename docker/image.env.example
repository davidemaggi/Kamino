# For compose.image.yml: copy next to it as `.env` and fill in. Never commit the filled-in file.

# Image version (a release tag): https://github.com/davidemaggi/Kamino/pkgs/container/kamino
KAMINO_VERSION=1.0.0-rc.5

# Public URL clients use (the tunnel's https hostname, no trailing slash).
KAMINO_PUBLIC_URL=https://kamino.example.com

# Password of the bundled Postgres. URL-safe characters only (letters, digits, - _ . ~).
# Postgres reads it only when its volume is first created: changing it later breaks the login.
KAMINO_DB_PASSWORD=

# 32 random bytes in base64. Generate it once:
#   docker run --rm ghcr.io/davidemaggi/kamino:1.0.0-rc.5 keys generate
# Keep a copy OFF the server (password manager): without it the data can't be read, and a
# different key makes the server refuse to start. It is not in the backups.
KAMINO_MASTER_KEY=

# Cloudflare Tunnel run by this compose (--profile cloudflare): the tunnel token from Zero Trust.
# Leave empty if the tunnel already runs on the host (then point it to http://localhost:8080).
# CLOUDFLARED_TOKEN=

# Optional
# KAMINO_PORT=8080
# KAMINO_LOG_LEVEL=info
