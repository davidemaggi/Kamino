{
  "name": "@kamino/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "kamino": "dist/cli/index.js"
  },
  "scripts": {
    "gen:build-info": "tsx scripts/gen-build-info.ts",
    "build": "tsx scripts/gen-build-info.ts && tsc -p tsconfig.build.json",
    "dev": "tsx scripts/gen-build-info.ts && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsx scripts/gen-build-info.ts && tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx scripts/gen-build-info.ts && vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/lib-storage": "^3.1164.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@kamino/brand": "workspace:*",
    "@kamino/protocol": "workspace:*",
    "@kamino/sync-core": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.5.0",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@kamino/sync-engine": "workspace:*",
    "@kamino/tsconfig": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "fast-check": "^4.10.2",
    "testcontainers": "^12.2.1",
    "ws": "^8.22.2"
  }
}
